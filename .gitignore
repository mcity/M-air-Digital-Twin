# Backups generated by install.sh
*.bak
*.bak.*

# Secrets — the real Google Maps API key lives in mcity_scripts/.env and
# must never be committed (.env.example is the template that ships instead)
.env
**/.env

# Python runtime artifacts
__pycache__/
*.py[cod]

# Logs left behind by test flights (e.g. projectairsim_client.log)
*.log

# Unreal Engine build/cache artifacts, in case the map content is ever
# opened in place — only Content/ is part of the package
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# Editor/OS noise
.vscode/
.idea/
.DS_Store
