# What install.py writes as maircorridor.env. For a manual install, copy this file to
# maircorridor.env and set every path.
# On Windows write paths as they are (C:\MAir\...); MAIR_PYTHON is ...\.venv\Scripts\python.exe.
UE_ROOT="/path/to/UnrealEngine"
MAIR_PROJECT="/path/to/M-air-Digital-Twin/MAirCorridorSim/MAirCorridorSim.uproject"
MAIR_PLUGIN="/path/to/M-air-Digital-Twin/MAirCorridorSim/Plugins/MAirCorridor"
MAIR_PYTHON="/path/to/M-air-Digital-Twin/.venv/bin/python"
PROJECTAIRSIM_ROOT="/path/to/M-air-Digital-Twin/ProjectAirSim"
MAIRCORRIDOR_ASSETS="/path/to/M-air-Digital-Twin/MAirCorridor_Assets"
MAIRCORRIDOR_PLAN="/path/to/M-air-Digital-Twin/MAirCorridor_Assets/ue_rect_3m/mcity_rect_3m.json"
