// robot_mcity_sensors.jsonc - the M-City drone with every sensor switched on.
//
// WHY THIS EXISTS. The config the scene used before this one is Project AirSim's own
// robot_quadrotor_fastphysics_weather sample, and it ships with the GPS, barometer and
// magnetometer declared but "enabled": false, with no lidar, no distance sensor and no battery.
// A sensor that is not enabled is never updated by the sim (Robot::Impl::UpdateSensors only
// touches enabled sensors), so it publishes nothing at all. That is fine for flying and useless
// for collecting data, which is what this config is for.
//
// WHAT CHANGED, AND WHAT DID NOT. The flight model is untouched: the links, joints, controller and
// actuators are exactly those of the sample this project has always flown, so the aircraft handles
// the same. Only the sensors are ours.
//
//   Chase           colour, 1280x720, streamed to the viewport as before
//   DownCamera      colour, depth, segmentation and surface normals, 640x360, ten a second
//   IMU1            as before
//   GPS             SWITCHED ON. This is the one that matters for comparing against a real
//                   flight: a real aircraft reports GPS, so the simulated one should too, with
//                   the same error model rather than a perfect pose
//   Barometer       SWITCHED ON, for height the way an aircraft actually measures it
//   Magnetometer    SWITCHED ON, for heading the way an aircraft actually measures it
//   Airspeed        added
//   Battery         added, discharging against rotor power
//   lidar1          added: 16 channels, 120 m, 150k points a second
//   DistanceSensor  added, looking down, 60 m
//
// DEPTH IS MILLIMETRES IN SIXTEEN BITS, and the sim casts to uint16 without clamping, so anything
// beyond 65.535 m WRAPS rather than saturating. A downward depth camera is therefore only
// meaningful below about 65 m above the ground. Above that, use the lidar.
//
// Derived from Project AirSim's robot_quadrotor_fastphysics_weather.jsonc and
// robot_quadrotor_fastphysics_sensors.jsonc. See PROVENANCE.md.
//
// THE RANGE SENSORS HANG WELL BELOW THE AIRFRAME, and that is not cosmetic. Both the lidar and
// the distance sensor trace on the Visibility channel from their own position, and the samples
// mount them within a few centimetres of the body. A flight recorded with them at 0.2 m gave an
// empty point cloud on every one of 374 lidar messages and a distance of exactly 0.00 on every
// one of 372, which is what a trace that starts inside its own aircraft looks like. 1.5 m down
// with self hits disabled puts the origin in clear air. If they still report nothing, the cause
// is the scene rather than the mounting: these are the sensors that query level geometry, and
// this scene is "UnrealNative", meaning our own level rather than one Project AirSim built.
//
// WHAT THIS DRONE COSTS TO RENDER, measured from recorded flights. Every camera capture is a full
// extra render of the scene, and the scene includes a 20 million triangle scan that cannot use
// Nanite. With everything on, one frame asked for up to 14 renders: the viewport, the chase camera,
// four down camera images, and EIGHT from the GPU lidar (four 90 degree depth captures and four
// intensity captures, every tick, with no rate limit). Cameras asking for 10 and 33 frames a second
// delivered 1.7 to 2.8, and the simulation fell to 0.87 of real time.
//
//   lidar1   SWITCHED OFF. Eight renders a frame and it has returned only empty clouds, in both its
//            CPU and GPU forms. Turn it back on to work on it, knowing what it costs.
//   Chase    asks for 10 frames a second, not 33. It is the most expensive capture and never got
//            above three.
{
  "physics-type": "fast-physics",
  "links": [
    {
      "name": "Frame",
      "inertial": {
        "mass": 1.0,
        "inertia": {
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        }
      },
      "collision": {
        "restitution": 0.1,
        "friction": 0.5
      },
      "visual": {
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/Quadrotor1"
        }
      }
    },
    {
      "name": "Prop_FL",
      "inertial": {
        "origin": {
          "xyz": "0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerRed"
        }
      }
    },
    {
      "name": "Prop_FR",
      "inertial": {
        "origin": {
          "xyz": "0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerRed"
        }
      }
    },
    {
      "name": "Prop_RL",
      "inertial": {
        "origin": {
          "xyz": "-0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "-0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerWhite"
        }
      }
    },
    {
      "name": "Prop_RR",
      "inertial": {
        "origin": {
          "xyz": "-0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "-0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerWhite"
        }
      }
    }
  ],
  "joints": [
    {
      "id": "Frame_Prop_FL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_FR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "axis": "0 0 1"
    }
  ],
  "controller": {
    "id": "Simple_Flight_Controller",
    "airframe-setup": "quadrotor-x",
    "type": "simple-flight-api",
    "simple-flight-api-settings": {
      "actuator-order": [
        {
          "id": "Prop_FR_actuator"
        },
        {
          "id": "Prop_RL_actuator"
        },
        {
          "id": "Prop_FL_actuator"
        },
        {
          "id": "Prop_RR_actuator"
        }
      ]
    }
  },
  "actuators": [
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "origin": {
        "xyz": "0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_FR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "origin": {
        "xyz": "0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "origin": {
        "xyz": "-0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "origin": {
        "xyz": "-0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    }
  ],
  "sensors": [
    {
      "id": "Chase",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.1,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 1280,
          "height": 720,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "gimbal": {
        "lock-roll": true,
        "lock-pitch": true,
        "lock-yaw": false
      },
      "origin": {
        "xyz": "-10.0 0.0 -1.0",
        "rpy-deg": "0 -11.46 0"
      }
    },
    {
      "id": "DownCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.1,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 640,
          "height": 360,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        },
        {
          "image-type": 1,
          "width": 640,
          "height": 360,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false
        },
        {
          "image-type": 3,
          "width": 640,
          "height": 360,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false
        },
        {
          "image-type": 6,
          "width": 640,
          "height": 360,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false
        }
      ],
      "origin": {
        "xyz": "0 0.0 0.0",
        "rpy-deg": "0 -90 0"
      }
    },
    {
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      "accelerometer": {
        "velocity-random-walk": 0.0023,
        "tau": 800,
        "bias-stability": 0.000353,
        "turn-on-bias": "0 0 0"
      },
      "gyroscope": {
        "angle-random-walk": 0.0001027,
        "tau": 500,
        "bias-stability": 2.23e-05,
        "turn-on-bias": "0 0 0"
      }
    },
    {
      "id": "GPS",
      "type": "gps",
      "enabled": true,
      "parent-link": "Frame",
      "eph-time-constant": 0.9,
      "epv-time-constant": 0.9,
      "eph-initial": 100,
      "epv-initial": 100,
      "eph-final": 0.1,
      "epv-final": 0.1,
      "eph-min_3d": 3.0,
      "eph-min_2d": 4.0
    },
    {
      "id": "Barometer",
      "type": "barometer",
      "enabled": true,
      "parent-link": "Frame",
      "qnh": 1013.25,
      "pressure-factor-sigma": 0.001825,
      "pressure-factor-tau": 3600,
      "uncorrelated-noise-sigma": 2.7,
      "update-latency": 0,
      "update-frequency": 50,
      "startup-delay": 0
    },
    {
      "id": "Magnetometer",
      "type": "magnetometer",
      "enabled": true,
      "parent-link": "Frame",
      "scale-factor": 1,
      "noise-sigma": "0.005 0.005 0.005",
      "noise-bias": "0.0 0.0 0.0"
    },
    {
      "id": "Airspeed",
      "type": "airspeed",
      "enabled": true,
      "parent-link": "Frame",
      "pressure-factor-sigma": 0.001825,
      "pressure-factor-tau": 3600,
      "uncorrelated-noise-sigma": 1.052,
      "forward-xyz": "1.0 0.0 0.0"
    },
    {
      "id": "Battery",
      "type": "battery",
      "enabled": true,
      "parent-link": "Frame",
      "total-battery-capacity": 36000,
      "battery-capacity-on-start": 30000,
      "battery-mode": "rotor-power-discharge-mode",
      "rotor-power-coefficient": 1
    },
    {
      "id": "lidar1",
      "type": "lidar",
      "lidar-type": "gpu_cylindrical",
      "enabled": false,
      "parent-link": "Frame",
      "number-of-channels": 16,
      "range": 120,
      "points-per-second": 150000,
      "horizontal-rotation-frequency": 10,
      "horizontal-fov-start-deg": 0.0,
      "horizontal-fov-end-deg": 360.0,
      "vertical-fov-upper-deg": 0.0,
      "vertical-fov-lower-deg": -45.0,
      "disable-self-hits": true,
      "report-point-cloud": true,
      "report-azimuth-elevation-range": false,
      "report-no-return-points": false,
      "draw-debug-points": false,
      "origin": {
        "xyz": "0 0 1.5",
        "rpy-deg": "0 0 0"
      }
    },
    {
      "id": "DistanceSensor",
      "type": "distance-sensor",
      "enabled": true,
      "parent-link": "Frame",
      "max-distance": 60.0,
      "min-distance": 0.5,
      "draw-debug-points": false,
      "origin": {
        "xyz": "0 0 1.5",
        "rpy-deg": "0 -90 0"
      }
    }
  ]
}
